{
  "name": "stampy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:test": "NODE_ENV=test next dev -p 3001",
    "seed": "tsx --env-file=.env.local src/scripts/seed.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run seed",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "geo-tz": "^8.1.11",
    "next": "^16.4.6",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prettier": "3.10.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "unrs-resolver@1.11.1": true
  }
}
